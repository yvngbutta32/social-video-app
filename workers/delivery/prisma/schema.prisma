generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String            @map("password_hash")
  name             String?
  avatarUrl        String?           @map("avatar_url")
  timezone         String            @default("UTC")
  locale           String            @default("en")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  lastLoginAt      DateTime?         @map("last_login_at")
  isActive         Boolean           @default(true) @map("is_active")
  emailVerified    Boolean           @default(false)
  role             UserRole          @default(viewer)
  usedInviteCodeId String?           @unique @map("used_invite_code_id")
  creatorProfile   CreatorProfile?
  inviteCodes      InviteCode[]      @relation("InviteCreatedBy")
  usedInviteCode   InviteCode?       @relation("InviteUsedBy")
  uploadedVideos   Video[]           @relation("VideoUploader")
  invitedMembers   WorkspaceMember[] @relation("WorkspaceInviter")
  workspaces       WorkspaceMember[]
  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")

  @@index([email])
  @@index([isActive])
  @@index([role])
  @@index([email], map: "idx_users_email")
  @@map("users")
}

model Workspace {
  id              String            @id @default(uuid())
  name            String
  slug            String            @unique
  ownerId         String            @map("owner_id")
  settings        Json              @default("{}")
  branding        Json              @default("{}")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  plan            WorkspacePlan     @default(free)
  abTests         ABTest[]
  hooks           Hook[]
  retentionCurves RetentionCurve[]
  scheduledPosts  ScheduledPost[]
  socialAccounts  SocialAccount[]
  subscriptions   Subscription[]
  videos          Video[]
  members         WorkspaceMember[]
  owner           User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([slug])
  @@index([ownerId], map: "idx_workspaces_owner")
  @@index([slug], map: "idx_workspaces_slug")
  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  invitedBy   String?   @map("invited_by")
  invitedAt   DateTime  @default(now()) @map("invited_at")
  joinedAt    DateTime? @map("joined_at")
  role        UserRole  @default(viewer)
  inviter     User?     @relation("WorkspaceInviter", fields: [invitedBy], references: [id])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([userId], map: "idx_ws_members_user")
  @@index([workspaceId], map: "idx_ws_members_workspace")
  @@map("workspace_members")
}

model SocialAccount {
  id                    String          @id @default(uuid())
  workspaceId           String          @map("workspace_id")
  platformUserId        String          @map("platform_user_id")
  username              String?
  displayName           String?         @map("display_name")
  avatarUrl             String?         @map("avatar_url")
  accessTokenEncrypted  String          @map("access_token_encrypted")
  refreshTokenEncrypted String?         @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime?       @map("token_expires_at")
  metadata              Json            @default("{}")
  isActive              Boolean         @default(true) @map("is_active")
  connectedAt           DateTime        @default(now()) @map("connected_at")
  lastSyncAt            DateTime?       @map("last_sync_at")
  platform              Platform
  scopes                Json            @default("[]")
  scheduledPosts        ScheduledPost[]
  workspace             Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform, platformUserId])
  @@index([workspaceId])
  @@index([platform])
  @@index([platform], map: "idx_social_accounts_platform")
  @@index([workspaceId], map: "idx_social_accounts_workspace")
  @@map("social_accounts")
}

model Video {
  id                 String          @id @default(uuid())
  workspaceId        String          @map("workspace_id")
  uploadedBy         String          @map("uploaded_by")
  title              String?
  description        String?
  originalFilename   String?         @map("original_filename")
  minioObjectKey     String          @map("minio_object_key")
  minioBucket        String          @default("videos") @map("minio_bucket")
  durationSeconds    Float?          @map("duration_seconds")
  width              Int?
  height             Int?
  fps                Float?
  fileSizeBytes      BigInt?         @map("file_size_bytes")
  mimeType           String?         @map("mime_type")
  metadata           Json            @default("{}")
  transcript         String?
  transcriptLanguage String?         @map("transcript_language")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  processedAt        DateTime?       @map("processed_at")
  status             VideoStatus     @default(uploading)
  contentMirrors     ContentMirror[]
  hooks              Hook[]
  variants           VideoVariant[]
  uploader           User            @relation("VideoUploader", fields: [uploadedBy], references: [id])
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)], map: "idx_videos_created")
  @@index([status], map: "idx_videos_status")
  @@index([workspaceId], map: "idx_videos_workspace")
  @@map("videos")
}

model VideoVariant {
  id                 String          @id @default(uuid())
  videoId            String          @map("video_id")
  variantType        String          @map("variant_type")
  aspectRatio        String          @map("aspect_ratio")
  hookId             String?         @map("hook_id")
  hookText           String?         @map("hook_text")
  caption            String?
  thumbnailObjectKey String?         @map("thumbnail_object_key")
  minioObjectKey     String?         @map("minio_object_key")
  durationSeconds    Float?          @map("duration_seconds")
  width              Int?
  height             Int?
  fileSizeBytes      BigInt?         @map("file_size_bytes")
  generationParams   Json            @default("{}") @map("generation_params")
  errorMessage       String?         @map("error_message")
  createdAt          DateTime        @default(now()) @map("created_at")
  completedAt        DateTime?       @map("completed_at")
  platform           Platform
  hashtags           Json            @default("[]")
  status             VariantStatus   @default(pending)
  scheduledPosts     ScheduledPost[]
  video              Video           @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([platform])
  @@index([status])
  @@index([platform], map: "idx_variants_platform")
  @@index([status], map: "idx_variants_status")
  @@index([videoId], map: "idx_variants_video")
  @@map("video_variants")
}

model Hook {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  videoId     String?   @map("video_id")
  niche       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  isActive    Boolean   @default(true) @map("is_active")
  metadata    Json      @default("{}")
  name        String
  text        String
  type        String
  updatedAt   DateTime  @updatedAt @map("updated_at")
  platform    Platform?
  video       Video?    @relation(fields: [videoId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([type])
  @@index([platform])
  @@index([niche, platform], map: "idx_hooks_niche_platform")
  @@index([videoId], map: "idx_hooks_video")
  @@index([workspaceId], map: "idx_hooks_workspace")
  @@map("hooks")
}

model ScheduledPost {
  id              String           @id @default(uuid())
  workspaceId     String           @map("workspace_id")
  variantId       String           @map("variant_id")
  socialAccountId String           @map("social_account_id")
  scheduledAt     DateTime         @map("scheduled_at")
  postedAt        DateTime?        @map("posted_at")
  platformPostId  String?          @map("platform_post_id")
  errorMessage    String?          @map("error_message")
  retryCount      Int              @default(0) @map("retry_count")
  abTestId        String?          @map("ab_test_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  abTestVariant   String?          @map("ab_test_variant")
  metadata        Json             @default("{}")
  platformUrl     String?          @map("platform_url")
  status          PostStatus       @default(draft)
  retentionCurves RetentionCurve[]
  abTest          ABTest?          @relation("ABTestVariants", fields: [abTestId], references: [id])
  socialAccount   SocialAccount    @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  variant         VideoVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([variantId])
  @@index([socialAccountId])
  @@index([abTestId])
  @@index([status])
  @@index([scheduledAt])
  @@index([status], map: "idx_scheduled_status")
  @@index([scheduledAt], map: "idx_scheduled_time")
  @@index([variantId], map: "idx_scheduled_variant")
  @@index([workspaceId], map: "idx_scheduled_workspace")
  @@map("scheduled_posts")
}

model ABTest {
  id                      String          @id @default(uuid())
  workspaceId             String          @map("workspace_id")
  name                    String
  hypothesis              String?
  testType                String          @map("test_type")
  confidenceLevel         Float           @default(0.95) @map("confidence_level")
  minimumDetectableEffect Float           @default(0.1) @map("minimum_detectable_effect")
  trafficSplit            Json            @default("{}") @map("traffic_split")
  winnerVariantId         String?         @map("winner_variant_id")
  startedAt               DateTime        @default(now()) @map("started_at")
  completedAt             DateTime?       @map("completed_at")
  results                 Json            @default("{}")
  status                  ABTestStatus    @default(RUNNING)
  workspace               Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  variants                ScheduledPost[] @relation("ABTestVariants")

  @@index([workspaceId])
  @@index([status])
  @@index([status], map: "idx_ab_tests_status")
  @@index([workspaceId], map: "idx_ab_tests_workspace")
  @@map("ab_tests")
}

model PostMetric {
  id               String   @id @default(uuid()) @db.Uuid
  scheduledPostId  String   @map("scheduled_post_id") @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  platform         Platform
  recordedAt       DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  views            BigInt?  @default(0)
  likes            BigInt?  @default(0)
  comments         BigInt?  @default(0)
  shares           BigInt?  @default(0)
  saves            BigInt?  @default(0)
  clicks           BigInt?  @default(0)
  reach            BigInt?  @default(0)
  impressions      BigInt?  @default(0)
  watchTimeSeconds BigInt?  @default(0) @map("watch_time_seconds")
  avgWatchTime     Decimal? @map("avg_watch_time") @db.Decimal(10, 2)
  completionRate   Decimal? @map("completion_rate") @db.Decimal(5, 4)
  followerGain     Int?     @default(0) @map("follower_gain")
  profileVisits    BigInt?  @default(0) @map("profile_visits")
  metadata         Json?    @default("{}")

  @@index([scheduledPostId, recordedAt(sort: Desc)])
  @@index([workspaceId, recordedAt(sort: Desc)])
  @@index([platform, recordedAt(sort: Desc)])
  @@index([platform, recordedAt(sort: Desc)], map: "idx_post_metrics_platform")
  @@index([scheduledPostId, recordedAt(sort: Desc)], map: "idx_post_metrics_post")
  @@index([workspaceId, recordedAt(sort: Desc)], map: "idx_post_metrics_workspace")
  @@map("post_metrics")
}

model RetentionCurve {
  id              String        @id @default(uuid())
  scheduledPostId String        @map("scheduled_post_id")
  workspaceId     String        @map("workspace_id")
  platform        Platform
  percentile10    Float?        @map("percentile_10")
  percentile25    Float?        @map("percentile_25")
  percentile50    Float?        @map("percentile_50")
  percentile75    Float?        @map("percentile_75")
  percentile90    Float?        @map("percentile_90")
  dropOffPoints   Json          @default("[]") @map("drop_off_points")
  calculatedAt    DateTime      @default(now()) @map("calculated_at")
  scheduledPost   ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([scheduledPostId])
  @@index([scheduledPostId], map: "idx_retention_post")
  @@map("retention_curves")
}

model RevenueEvent {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  source      String   @db.VarChar(50)
  amountCents Int      @map("amount_cents")
  currency    String?  @default("USD") @db.VarChar(3)
  recorded_at DateTime @default(now()) @db.Timestamptz(6)
  metadata    Json?    @default("{}")

  @@map("revenue_events")
}

model TrendSignal {
  id               String      @id @default(uuid())
  source           TrendSource
  sourceId         String      @map("source_id")
  niche            String?
  keywords         Json        @default("[]")
  title            String?
  url              String?
  velocityScore    Float?      @map("velocity_score")
  volumeScore      Float?      @map("volume_score")
  relevanceScore   Float?      @map("relevance_score")
  competitionScore Float?      @map("competition_score")
  brandSafetyScore Float?      @map("brand_safety_score")
  compositeScore   Float?      @map("composite_score")
  metadata         Json        @default("{}")
  detectedAt       DateTime    @default(now()) @map("detected_at")
  expiresAt        DateTime?   @map("expires_at")

  @@index([niche, detectedAt(sort: Desc)])
  @@index([compositeScore(sort: Desc)])
  @@index([source, detectedAt(sort: Desc)])
  @@index([compositeScore(sort: Desc)], map: "idx_trends_composite")
  @@index([niche, detectedAt(sort: Desc)], map: "idx_trends_niche")
  @@index([source, detectedAt(sort: Desc)], map: "idx_trends_source")
  @@map("trend_signals")
}

model TrendSuggestion {
  id              String       @id @default(uuid()) @db.Uuid
  workspaceId     String       @map("workspace_id") @db.Uuid
  source          TrendSource
  source_id       String?      @db.VarChar(255)
  title           String
  description     String?
  niche           String?      @db.VarChar(100)
  platform        Platform?
  keywords        String[]
  viral_potential Decimal?     @db.Decimal(4, 3)
  trend_velocity  Decimal?     @db.Decimal(6, 3)
  raw_data        Json?        @default("{}")
  fetched_at      DateTime     @default(now()) @db.Timestamptz(6)
  expires_at      DateTime?    @db.Timestamptz(6)

  @@map("trend_suggestions")
}

model PerformancePattern {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  patternType   String    @map("pattern_type") @db.VarChar(50)
  pattern_data  Json
  confidence    Decimal   @db.Decimal(4, 3)
  sample_size   Int
  discovered_at DateTime  @default(now()) @db.Timestamptz(6)
  valid_until   DateTime? @db.Timestamptz(6)

  @@map("performance_patterns")
}


model UsageEvent {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  user_id       String?  @db.Uuid
  eventType     String   @map("event_type") @db.VarChar(50)
  resource_type String?  @db.VarChar(50)
  resource_id   String?  @db.Uuid
  properties    Json?    @default("{}")
  recorded_at   DateTime @default(now()) @db.Timestamptz(6)

  @@map("usage_events")
}

model Subscription {
  id                   String    @id @default(uuid())
  workspaceId          String    @map("workspace_id")
  stripeCustomerId     String?   @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  stripePriceId        String?   @map("stripe_price_id")
  status               String?
  currentPeriodStart   DateTime? @map("current_period_start")
  currentPeriodEnd     DateTime? @map("current_period_end")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([stripeSubscriptionId])
  @@index([stripeSubscriptionId], map: "idx_subscriptions_stripe")
  @@index([workspaceId], map: "idx_subscriptions_workspace")
  @@map("subscriptions")
}

model InviteCode {
  id          String       @id @default(uuid())
  code        String       @unique @default(cuid())
  email       String
  role        UserRole     @default(creator)
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  maxUses     Int          @default(1)
  usedCount   Int          @default(0)
  createdById String
  usedById    String?      @unique
  createdAt   DateTime     @default(now())
  usedAt      DateTime?
  createdBy   User         @relation("InviteCreatedBy", fields: [createdById], references: [id])
  usedBy      User?        @relation("InviteUsedBy", fields: [usedById], references: [id])

  @@index([email])
  @@index([status])
  @@map("invite_codes")
}

model CreatorProfile {
  id             String          @id @default(uuid())
  userId         String          @unique @map("user_id")
  handle         String          @unique
  displayName    String?         @map("display_name")
  niche          String
  bio            String?
  tier           CreatorTier     @default(BETA)
  folderPath     String          @map("folder_path")
  autoMirror     Boolean         @default(true) @map("auto_mirror")
  mirrorConfig   Json            @default("{}") @map("mirror_config")
  settings       Json            @default("{}")
  metrics        Json            @default("{}")
  lastActiveAt   DateTime?       @map("last_active_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  contentMirrors ContentMirror[]
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([handle])
  @@index([tier])
  @@map("creator_profiles")
}

model ContentMirror {
  id              String         @id @default(uuid())
  creatorId       String         @map("creator_id")
  originalVideoId String         @map("original_video_id")
  variantIds      Json           @default("[]") @map("variant_ids")
  archivePath     String         @map("archive_path")
  mirrorStatus    MirrorStatus   @default(PENDING) @map("mirror_status")
  checksum        String
  sizeBytes       BigInt
  metadata        Json           @default("{}")
  deliveryStatus  DeliveryStatus @default(PENDING) @map("delivery_status")
  deliveryPath    String?        @map("delivery_path")
  deliveredAt     DateTime?      @map("delivered_at")
  error           String?
  createdAt       DateTime       @default(now()) @map("created_at")
  completedAt     DateTime?      @map("completed_at")
  creator         CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  originalVideo   Video          @relation(fields: [originalVideoId], references: [id], onDelete: Cascade)
  deliveryLogs    DeliveryLog[]

  @@index([creatorId])
  @@index([mirrorStatus])
  @@index([createdAt(sort: Desc)])
  @@map("content_mirrors")
}

model DeliveryConfig {
  id          String              @id @default(uuid())
  name        String              @unique
  destination DeliveryDestination
  config      Json
  schedule    String
  enabled     Boolean             @default(true)
  lastRun     DateTime?           @map("last_run")
  nextRun     DateTime?           @map("next_run")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  deliveryLogs DeliveryLog[]

  @@map("delivery_configs")
}

model DeliveryLog {
  id           String         @id @default(uuid())
  mirrorId     String         @map("mirror_id")
  configId     String         @map("config_id")
  destination  DeliveryDestination
  status       DeliveryStatus
  filePath     String?        @map("file_path")
  size         BigInt?
  checksum     String?
  url          String?
  error        String?
  metadata     Json?
  retryCount   Int            @default(0) @map("retry_count")
  createdAt    DateTime       @default(now()) @map("created_at")
  mirror       ContentMirror  @relation(fields: [mirrorId], references: [id], onDelete: Cascade)
  config       DeliveryConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([mirrorId])
  @@index([configId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("delivery_logs")
}


model RetentionAnalysis {
  id                String   @id @default(uuid())
  scheduledPostId   String   @map("scheduled_post_id")
  workspaceId       String   @map("workspace_id")
  creatorId         String   @map("creator_id")
  platform          Platform
  sceneData         Json     @map("scene_data")
  dropOffPoints     Json     @map("drop_off_points")
  hookEffectiveness Float?   @map("hook_effectiveness")
  optimalCutPoints  Json     @map("optimal_cut_points")
  analyzedAt        DateTime @default(now()) @map("analyzed_at")

  @@index([scheduledPostId])
  @@index([creatorId])
  @@index([platform])
  @@map("retention_analyses")
}

model EngagementVelocity {
  id                    String   @id @default(uuid())
  workspaceId           String   @map("workspace_id")
  creatorId             String   @map("creator_id")
  platform              Platform
  contentId             String   @map("content_id")
  scheduledPostId       String   @map("scheduled_post_id")
  
  // Velocity metrics (views/min)
  velocityImmediate     Float    @default(0) @map("velocity_immediate")
  velocityShort         Float    @default(0) @map("velocity_short")
  velocityMedium        Float    @default(0) @map("velocity_medium")
  velocityLong          Float    @default(0) @map("velocity_long")
  
  // Acceleration metrics (views/min²)
  accelerationImmediate Float    @default(0) @map("acceleration_immediate")
  accelerationShort     Float    @default(0) @map("acceleration_short")
  accelerationMedium    Float    @default(0) @map("acceleration_medium")
  accelerationLong      Float    @default(0) @map("acceleration_long")
  
  // Engagement
  engagementRate        Float    @default(0) @map("engagement_rate")
  shareVelocity         Float    @default(0) @map("share_velocity")
  retentionScore        Float    @default(0) @map("retention_score")
  
  // Viral scoring
  viralProbability      Float    @default(0) @map("viral_probability")
  viralStage            ViralStage @default(DORMANT) @map("viral_stage")
  
  // Current totals
  currentViews          BigInt   @default(0) @map("current_views")
  currentLikes          BigInt   @default(0) @map("current_likes")
  currentComments       BigInt   @default(0) @map("current_comments")
  currentShares         BigInt   @default(0) @map("current_shares")
  currentSaves          BigInt   @default(0) @map("current_saves")
  
  calculatedAt          DateTime @default(now()) @map("calculated_at")
  
  @@index([workspaceId, calculatedAt])
  @@index([creatorId, calculatedAt])
  @@index([contentId])
  @@index([viralProbability])
  @@index([viralStage])
  @@map("engagement_velocities")
}

model PlatformRankingFactor {
  id                String   @id @default(uuid())
  platform          Platform
  niche             String
  factorName        String   @map("factor_name")
  factorCategory    FactorCategory @map("factor_category")
  weight            Float
  confidence        Float
  sampleSize        Int      @map("sample_size")
  version           Int      @default(1)
  isActive          Boolean  @default(true) @map("is_active")
  metadata          Json
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  
  @@unique([platform, niche, factorName, version])
  @@index([platform, niche, weight])
  @@index([isActive])
  @@map("platform_ranking_factors")
}

model CreatorAlgorithmProfile {
  id                      String   @id @default(uuid())
  workspaceId             String   @map("workspace_id")
  creatorId               String   @map("creator_id")
  platform                Platform
  niche                   String
  
  // Learned preferences (JSON for flexibility)
  optimalHookTypes        Json     @default("{}") @map("optimal_hook_types")
  optimalPostingWindows   Json     @default("{}") @map("optimal_posting_windows")
  optimalDurations        Json     @default("{}") @map("optimal_durations")
  contentPillars          Json     @default("{}") @map("content_pillars")
  audiencePsychographics  Json     @default("{}") @map("audience_psychographics")
  ctaPerformance          Json     @default("{}") @map("cta_performance")
  hashtagStrategy         Json     @default("{}") @map("hashtag_strategy")
  soundStrategy           Json     @default("{}") @map("sound_strategy")
  
  // Model metadata
  modelVersion            Int      @default(1) @map("model_version")
  trainingSamples         Int      @default(0) @map("training_samples")
  lastTrainedAt           DateTime? @map("last_trained_at")
  accuracyScore           Float    @default(0) @map("accuracy_score")
  featureImportance       Json     @default("{}") @map("feature_importance")
  
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  
  @@unique([workspaceId, creatorId, platform, niche])
  @@index([workspaceId, creatorId])
  @@map("creator_algorithm_profiles")
}

model ViralPrediction {
  id                  String   @id @default(uuid())
  workspaceId         String   @map("workspace_id")
  creatorId           String   @map("creator_id")
  contentId           String   @map("content_id")
  platform            Platform
  niche               String
  
  // Predictions
  predictedViews      BigInt   @map("predicted_views")
  predictedEngagement Float    @map("predicted_engagement")
  predictedViralProb  Float    @map("predicted_viral_prob")
  predictedStage      ViralStage @map("predicted_stage")
  confidenceInterval  Json     @map("confidence_interval")
  
  // Features used
  inputFeatures       Json     @map("input_features")
  modelVersion        Int      @map("model_version")
  
  // Actuals (filled later)
  actualViews         BigInt?  @map("actual_views")
  actualEngagement    Float?   @map("actual_engagement")
  actualViralStage    ViralStage? @map("actual_viral_stage")
  accuracyScore       Float?   @map("accuracy_score")
  
  predictedAt         DateTime @default(now()) @map("predicted_at")
  validatedAt         DateTime? @map("validated_at")
  
  @@index([workspaceId, predictedAt])
  @@index([creatorId, predictedAt])
  @@index([contentId])
  @@map("viral_predictions")
}

model HookABTest {
  id                  String   @id @default(uuid())
  workspaceId         String   @map("workspace_id")
  creatorId           String   @map("creator_id")
  contentId           String   @map("content_id")
  platform            Platform
  
  // Test configuration
  hookVariants        Json     @map("hook_variants")
  trafficSplit        Json     @map("traffic_split")
  minSampleSize       Int      @default(100) @map("min_sample_size")
  confidenceLevel     Float    @default(0.95) @map("confidence_level")
  maxDurationHours    Int      @default(24) @map("max_duration_hours")
  
  // Results
  status              ABTestStatus @default(RUNNING)
  winnerVariantId     String?  @map("winner_variant_id")
  winnerConfidence    Float?   @map("winner_confidence")
  results             Json     @default("{}")
  
  startedAt           DateTime @default(now()) @map("started_at")
  endedAt             DateTime? @map("ended_at")
  decidedAt           DateTime? @map("decided_at")
  
  @@index([workspaceId, status])
  @@index([contentId])
  @@map("hook_ab_tests")
}

model TrendConcept {
  id                  String   @id @default(uuid())
  workspaceId         String   @map("workspace_id")
  trendId             String   @map("trend_id")
  trendName           String   @map("trend_name")
  trendPlatform       Platform @map("trend_platform")
  trendNiche          String   @map("trend_niche")
  trendScore          Float    @map("trend_score")
  trendLifecycleStage TrendLifecycleStage @map("trend_lifecycle_stage")
  
  // Generated concepts
  concepts            Json     @default("[]")
  selectedConceptId   String?  @map("selected_concept_id")
  
  // Scheduling
  scheduledAt         DateTime? @map("scheduled_at")
  publishedAt         DateTime? @map("published_at")
  status              ConceptStatus @default(GENERATED)
  
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  
  @@index([workspaceId, createdAt])
  @@index([trendId])
  @@index([status])
  @@map("trend_concepts")
}

model RevenueAttribution {
  id                  String   @id @default(uuid())
  workspaceId         String   @map("workspace_id")
  creatorId           String   @map("creator_id")
  contentId           String?  @map("content_id")
  scheduledPostId     String?  @map("scheduled_post_id")
  
  touchpointId        String   @unique @map("touchpoint_id")
  touchpointType      TouchpointType @map("touchpoint_type")
  platform            Platform
  utmParams           Json     @map("utm_params")
  
  funnelStage         FunnelStage @map("funnel_stage")
  sequenceNumber      Int      @map("sequence_number")
  
  attributedRevenue   Decimal  @default(0) @map("attributed_revenue")
  revenueCurrency     String   @default("USD") @map("revenue_currency")
  attributionModel    AttributionModel @default(DATA_DRIVEN) @map("attribution_model")
  confidence          Float    @default(0)
  
  sessionId           String?  @map("session_id")
  deviceFingerprint   String?  @map("device_fingerprint")
  ipHash              String?  @map("ip_hash")
  
  // Relations
  conversionEvents    ConversionEvent[] @relation("ConversionTouchpoints")
  primaryConversion   ConversionEvent?  @relation("PrimaryAttribution")
  
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  
  @@index([workspaceId, createdAt])
  @@index([creatorId, createdAt])
  @@index([contentId])
  @@index([touchpointId])
  @@map("revenue_attributions")
}

model ConversionEvent {
  id                  String   @id @default(uuid())
  workspaceId         String   @map("workspace_id")
  creatorId           String   @map("creator_id")
  
  eventType           ConversionType @map("event_type")
  productId           String?  @map("product_id")
  productName         String   @map("product_name")
  amount              Decimal
  currency            String   @default("USD")
  isRecurring         Boolean  @default(false) @map("is_recurring")
  recurrenceInterval  String?  @map("recurrence_interval")
  
  touchpoints         RevenueAttribution[] @relation("ConversionTouchpoints")
  primaryAttribution  RevenueAttribution?  @relation("PrimaryAttribution", fields: [primaryAttributionId], references: [id])
  primaryAttributionId String? @unique @map("primary_attribution_id")
  attributionModel    AttributionModel @default(DATA_DRIVEN) @map("attribution_model")
  
  customerEmail       String?  @map("customer_email")
  customerId          String?  @map("customer_id")
  customerLTV         Decimal  @default(0) @map("customer_ltv")
  
  metadata            Json
  createdAt           DateTime @default(now()) @map("created_at")
  
  @@index([workspaceId, createdAt])
  @@index([creatorId, createdAt])
  @@index([customerEmail])
  @@map("conversion_events")
}

model ProductFunnel {
  id                  String   @id @default(uuid())
  workspaceId         String   @map("workspace_id")
  creatorId           String   @map("creator_id")
  productId           String   @map("product_id")
  productName         String   @map("product_name")
  productType         ProductType @map("product_type")
  
  stages              Json
  
  totalViews          Int      @default(0) @map("total_views")
  totalLeads          Int      @default(0) @map("total_leads")
  totalCustomers      Int      @default(0) @map("total_customers")
  totalRevenue        Decimal  @default(0) @map("total_revenue")
  avgOrderValue       Decimal  @default(0) @map("avg_order_value")
  conversionRate      Float    @default(0) @map("conversion_rate")
  
  priceTests          PriceTest[]
  bundleTests         BundleTest[]
  upsellOffers        UpsellOffer[]
  
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  
  @@index([workspaceId, creatorId])
  @@map("product_funnels")
}

model PriceTest {
  id                  String   @id @default(uuid())
  productFunnelId     String   @map("product_funnel_id")
  productFunnel       ProductFunnel @relation(fields: [productFunnelId], references: [id])
  
  variantA            Decimal
  variantB            Decimal
  trafficSplit        Float    @default(0.5) @map("traffic_split")
  status              TestStatus @default(RUNNING)
  winner              String?
  confidence          Float?
  
  startedAt           DateTime @default(now()) @map("started_at")
  endedAt             DateTime? @map("ended_at")
  
  @@index([productFunnelId, status])
  @@map("price_tests")
}

model BundleTest {
  id                  String   @id @default(uuid())
  productFunnelId     String   @map("product_funnel_id")
  productFunnel       ProductFunnel @relation(fields: [productFunnelId], references: [id])
  
  bundleProducts      String[] @map("bundle_products")
  bundlePrice         Decimal  @map("bundle_price")
  status              TestStatus @default(RUNNING)
  winner              Boolean  @default(false)
  
  startedAt           DateTime @default(now()) @map("started_at")
  endedAt             DateTime? @map("ended_at")
  
  @@index([productFunnelId, status])
  @@map("bundle_tests")
}

model UpsellOffer {
  id                  String   @id @default(uuid())
  productFunnelId     String   @map("product_funnel_id")
  productFunnel       ProductFunnel @relation(fields: [productFunnelId], references: [id])
  
  triggerProductId    String   @map("trigger_product_id")
  upsellProductId     String   @map("upsell_product_id")
  offerPrice          Decimal  @map("offer_price")
  conversionRate      Float    @default(0) @map("conversion_rate")
  isActive            Boolean  @default(true) @map("is_active")
  
  @@index([productFunnelId, triggerProductId])
  @@map("upsell_offers")
}

model AdminAuditLog {
  id           String   @id @default(uuid())
  adminId      String   @map("admin_id")
  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([createdAt(sort: Desc)])
  @@map("admin_audit_logs")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String?  @map("workspace_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String?  @map("resource_type") @db.VarChar(50)
  resourceId   String?  @map("resource_id") @db.Uuid
  oldValues    Json?    @map("old_values")
  newValues    Json?    @map("new_values")
  ipAddress    String?  @map("ip_address") @db.Inet
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)], map: "idx_audit_action")
  @@index([userId, createdAt(sort: Desc)], map: "idx_audit_user")
  @@index([workspaceId, createdAt(sort: Desc)], map: "idx_audit_workspace")
  @@map("audit_logs")
}

